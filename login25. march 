"use client";

import { useState, useEffect } from "react";
import WelcomePage from "./components/WelcomePage";
import LoginPage from "./components/auth/LoginPage";
import RegisterPage from "./components/auth/RegisterPage";
import Dashboard from "./components/dashboard/Dashboard";
import { styles } from "./styles/AppStyles";
import AdminDashboard from "./components/admin/AdminDashboard";

export default function SBIApp() {
  const [currentPage, setCurrentPage] = useState("welcome");
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [loading, setLoading] = useState(true); // true on first load to check session
  const [error, setError] = useState("");
  const [user, setUser] = useState(null);

  const BASE_URL = process.env.NEXT_PUBLIC_API_URL;

  /*
  ============================
  FETCH USER PROFILE (COOKIE BASED)
  ============================
  */
  const fetchUserProfile = async () => {
    try {
      const response = await fetch(`${BASE_URL}/users/me`, {
        method: "GET",
        credentials: "include", // sends existing cookie automatically
        headers: {
          Accept: "application/json",
        },
      });

      let userData;
      try {
        userData = await response.json();
      } catch {
        userData = {};
      }

      // 401 means no valid cookie — user is not logged in, that's fine
      if (!response.ok) {
        return false; // session not found
      }

      if (!userData || typeof userData !== "object") {
        return false;
      }

      console.log("fetchUserProfile userData:", userData);

      const resolvedUserType = Number(
        userData.userType ?? userData.user_type ?? 0
      );

      console.log("Resolved userType:", resolvedUserType);

      setUser({
        ...userData,
        userType: resolvedUserType,
      });

      setIsLoggedIn(true);
      return true; // session found

    } catch (err) {
      console.error("fetchUserProfile error:", err);
      return false;
    }
  };

  /*
  ============================
  ON APP LOAD — CHECK EXISTING SESSION
  If cookie already exists in browser, fetch profile silently.
  This prevents re-login after page refresh.
  ============================
  */
  useEffect(() => {
    const checkSession = async () => {
      setLoading(true);
      await fetchUserProfile();
      setLoading(false);
    };

    checkSession();
  }, []); // runs once on mount

  /*
  ============================
  LOGIN SUCCESS
  Called by LoginPage after /token succeeds and cookie is freshly set
  ============================
  */
  const handleLoginSuccess = async () => {
    setLoading(true);
    await fetchUserProfile();
    setLoading(false);
  };

  /*
  ============================
  LOGOUT
  ============================
  */
  const handleLogout = async () => {
    try {
      await fetch(`${BASE_URL}/logout`, {
        method: "POST",
        credentials: "include",
      });
    } catch (err) {
      console.error("Logout error:", err);
    }

    setUser(null);
    setIsLoggedIn(false);
    setCurrentPage("welcome");
  };

  /*
  ============================
  LOADING SCREEN
  ============================
  */
  if (loading) {
    return (
      <div style={styles.loadingContainer}>
        <div style={styles.spinner}></div>
        <p style={styles.loadingText}>Loading...</p>
      </div>
    );
  }

  /*
  ============================
  ROUTING
  ============================
  */

  // Not logged in — show welcome / login / register
  if (!isLoggedIn) {
    if (currentPage === "welcome") {
      return <WelcomePage onNavigate={setCurrentPage} />;
    }
    if (currentPage === "login") {
      return (
        <LoginPage
          onLoginSuccess={handleLoginSuccess}
          onNavigate={setCurrentPage}
        />
      );
    }
    if (currentPage === "register") {
      return <RegisterPage onNavigate={setCurrentPage} />;
    }
  }

  // Logged in — route PURELY by userType
  if (isLoggedIn && user) {
    console.log("Routing — user.userType:", user.userType);

    if (user.userType === 1) {
      return <AdminDashboard user={user} onLogout={handleLogout} />;
    }
    return <Dashboard user={user} onLogout={handleLogout} />;
  }

  // Fallback
  return (
    <div style={styles.loadingContainer}>
      <div style={styles.spinner}></div>
      <p style={styles.loadingText}>Loading...</p>
    </div>
  );
}
